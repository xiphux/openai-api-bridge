# openai-api-bridge — provider config
#
# This file declares the upstream image/video generation backends the bridge
# fronts. Each [[providers]] block becomes addressable as `{id}/{model_slug}`
# in the OpenAI `model` field. Adding more ComfyUI instances or future
# backends is purely a config change — no code edit required.
#
# Secrets are stored as the *name of an env var* (any field whose name ends
# in `_env`). The actual value is read from the process environment, so this
# file stays safe to check into a private repo.

[defaults]
cache_workflows = true                 # rescan only when bridge restarts


# --- ComfyUI ----------------------------------------------------------------
# Discovers workflows from a flat directory of `<name>.json` + `<name>.meta.json`
# pairs. See "Workflow meta.json schema" in the README for the full field
# reference.

[[providers]]
id = "comfyui"
backend = "comfyui"
url = "http://127.0.0.1:8188"
workflows_dir = "/var/lib/openai-api-bridge/workflows"
poll_interval_seconds = 1.0
poll_timeout_image_seconds = 300
poll_timeout_video_seconds = 900


# Example: a second ComfyUI instance, addressed as "comfyui-experimental/<slug>".
# Uncomment and adjust to use.
#
# [[providers]]
# id = "comfyui-experimental"
# backend = "comfyui"
# url = "http://192.168.1.20:8188"
# workflows_dir = "/var/lib/openai-api-bridge/workflows-exp"


# --- Venice -----------------------------------------------------------------
# Native API (not OpenAI-compatible upstream — the bridge translates).
# Set VENICE_API_TOKEN in the environment to enable this provider.
#
# Venice files text-to-image under type=image and image-to-image under
# type=inpaint, naming the latter by suffixing the base id (`gpt-image-2` ->
# `gpt-image-2-edit`), and its edit endpoint accepts *only* the suffixed form.
# The bridge lists the pair once and routes edits to the counterpart, so
# clients address one model id either way.

[[providers]]
id = "venice"
backend = "venice"
base_url = "https://api.venice.ai"
api_token_env = "VENICE_API_TOKEN"
# Optional diffusion knobs (uncomment to override defaults):
# steps = 16
# cfg_scale = 4.0
# default_width = 1024
# default_height = 1024
#
# Cooldown before re-reading the model catalogue after a failed attempt to
# resolve edit routing. While the window is open edits go out unrouted and
# Venice rejects them, so this trades a bounded tail after recovery against
# re-fetching the catalogue on every edit during an outage. 0 disables the
# cooldown — which reinstates exactly that retry storm.
# route_retry_seconds = 60.0
#
# How long a successfully-read model catalogue is reused. /v1/models costs two
# upstream calls here (the text-to-image and image-to-image listings), and edit
# routing reads the same catalogue. A listing whose inpaint half failed is
# still served, but held only for catalog_retry_seconds below (or this value,
# whichever is shorter), so the missing half is re-attempted sooner than a
# healthy listing would be. 0 disables caching.
# catalog_ttl_seconds = 300.0
#
# After a failed fetch, callers arriving within this window get the remembered
# error instead of starting another attempt. 0 retries immediately.
# catalog_retry_seconds = 30.0


# --- ImageRouter ------------------------------------------------------------
# Cloud aggregator covering image and video models from many providers
# (FLUX, GPT-Image, Stable Diffusion, Stable Video, etc.). OpenAI-compat
# *content* but path-divergent — the bridge translates: model catalog at
# /v2/models, inference at /v1/openai/{images,videos}/..., video sync.
# Set IMAGEROUTER_API_KEY in the environment to enable this provider.

# [[providers]]
# id = "imagerouter"
# backend = "imagerouter"
# api_token_env = "IMAGEROUTER_API_KEY"
# # base_url defaults to https://api.imagerouter.io and rarely needs override
# # catalog_ttl_seconds = 300.0   # reuse the model listing for this long
# #                               # (0 = re-fetch on every /v1/models)
# # catalog_retry_seconds = 30.0  # after a failed fetch, fail fast for this
# #                               # long instead of each caller retrying


# --- OpenAI passthrough -----------------------------------------------------
# Generic OpenAI-compatible upstream — local llama-server, vLLM, lmstudio,
# OpenAI itself, or any vendor that speaks the OpenAI wire protocol.
# Requests pass through unchanged; the bridge only routes and prefixes
# model ids. Supports /v1/chat/completions (sync + streaming) and
# /v1/embeddings.
#
# Configure as many as you have — each gets a unique id and the bridge
# aggregates all of their /v1/models into one unified listing.

# Example: a local llama-server with no auth.
# [[providers]]
# id = "llama-main"
# backend = "openai"
# base_url = "http://192.168.1.10:8080"
# # api_token_env omitted -> no Authorization header sent upstream

# Example: a second llama-server, addressed as "llama-fast/<model-id>".
# [[providers]]
# id = "llama-fast"
# backend = "openai"
# base_url = "http://192.168.1.11:8080"

# Example: an OpenAI-compatible hosted provider (Together, Groq, etc.).
# [[providers]]
# id = "groq"
# backend = "openai"
# base_url = "https://api.groq.com/openai"
# api_token_env = "GROQ_API_KEY"
# request_timeout_seconds = 120.0

# Note: for OpenRouter, prefer the dedicated `openrouter` backend below
# rather than configuring it as openai-passthrough. OpenRouter's image
# generation uses a non-standard chat-completions shape that the
# passthrough doesn't translate — image models would appear in the
# catalog but silently return text-only.


# --- OpenRouter -------------------------------------------------------------
# Multi-vendor aggregator with chat, embeddings, and image generation.
# Chat + embeddings are spec-compliant; the bridge translates image gen
# (which OpenRouter exposes via chat completions with non-standard
# `message.images` array on the response) into standard /v1/images
# endpoints for clients.
# Set OPENROUTER_API_KEY in the environment to enable this provider.

# [[providers]]
# id = "openrouter"
# backend = "openrouter"
# api_token_env = "OPENROUTER_API_KEY"
# # base_url defaults to https://openrouter.ai/api and rarely needs override
# # request_timeout_seconds = 120.0
# # catalog_ttl_seconds = 300.0   # reuse the model listing for this long
# #                               # (0 = re-fetch on every /v1/models)
# # catalog_retry_seconds = 30.0  # after a failed fetch, fail fast for this
# #                               # long instead of each caller retrying


# --- fal.ai -----------------------------------------------------------------
# Model-hosting broker for tier-1 image models (Seedream, Nano Banana / Gemini
# image, GPT Image, FLUX, …). Unlike ImageRouter/OpenRouter, fal exposes each
# model's *native* input schema — which includes the per-model content-
# moderation knob. The bridge reads each model's OpenAPI schema and sets that
# knob to its loosest value (enable_safety_checker=false, or the top of the
# model's own safety_tolerance enum), so tier-1 models can be driven past the
# over-eager default guardrails that flat OpenAI-shaped brokers don't let you
# touch — and new model versions are picked up without a code change.
#
# By default the bridge populates /v1/models from fal's model API, filtered to
# the categories it can serve: text-to-image, image-to-image, text-to-video and
# image-to-video (~886 models). fal's audio/3d categories are NOT listed —
# there's no code path for them, so those models would fail on every request.
# Images run against the synchronous endpoint; video goes through fal's queue
# and is served through the bridge's async /v1/videos lifecycle.
#
# [[providers.models]] entries are per-model *overrides*, not a whitelist: they
# tweak a discovered model without restricting the rest. To serve only a fixed
# set instead, set discover_models = false and list them.
# `id` is the fal model path (also the /v1/models slug, addressed by the client
# as `fal/<id>`). Set FAL_API_KEY in the environment to enable this provider.

# [[providers]]
# id = "fal"
# backend = "fal"
# api_token_env = "FAL_API_KEY"
# # base_url defaults to https://fal.run (fal's synchronous endpoint)
# # request_timeout_seconds = 600.0
#
#   [[providers.models]]
#   id = "fal-ai/bytedance/seedream/v4/text-to-image"
#   display_name = "Seedream 4"
#   # disable_safety defaults to true -> schema says enable_safety_checker,
#   # so the bridge sends enable_safety_checker=false
#
#   [[providers.models]]
#   id = "fal-ai/bytedance/seedream/v4/edit"      # img2img edit endpoint
#   display_name = "Seedream 4 (edit)"
#
#   [[providers.models]]
#   id = "fal-ai/nano-banana-2"                   # enum tops out at 6 ->
#   display_name = "Nano Banana 2"                # safety_tolerance="6"
#
#   [[providers.models]]
#   id = "openai/gpt-image-2"                     # fal's gpt-image exposes NO
#   display_name = "GPT Image 2"                  # moderation knob; nothing injected
#
# Provider-level. Every line below shows the value you'd write to CHANGE the
# behaviour, with the shipped default noted after it — so a line reading
# `= false` means the default is true. Nothing here needs to be set.
#
#   discover_models = false     # (default: true) serve only the
#                               # [[providers.models]] above; a model outside
#                               # that list becomes a 404
#   categories = ["text-to-image", "image-to-image"]
#                               # (default: all four the backend can serve)
#   collapse_variants = false   # (default: true — pairs ARE collapsed) list a
#                               # model's /edit half separately instead of
#                               # routing edits to it automatically.
#                               # A [[providers.models]] block for a collapsed
#                               # sibling layers over the base model's block on
#                               # routed requests — fields it omits keep the
#                               # base's values, and params merge key-by-key.
#
#   --- upstream data retention: BOTH are opt-in, and off unless set ---
#   store_payloads = false      # (default: true — fal DOES keep your prompts
#                               # and inline input images for 30 days) sends
#                               # X-Fal-Store-IO: 0 so it never stores them
#   output_expiration_seconds = 600
#                               # (default: unset — generated media persists on
#                               # fal's CDN indefinitely) expire it after N
#                               # seconds. Must leave time to download it
#                               # first: values under 60s are rejected, and a
#                               # few hundred is the comfortable range
#
#   video_poll_interval_seconds = 3.0     # (default) queue polling cadence
#   video_poll_timeout_seconds = 1800.0   # (default) give up on a job after this
#   queue_base_url = "https://queue.fal.run"        # (default) rarely overridden
#   models_api_url = "https://api.fal.ai/v1/models" # (default) rarely overridden
#   introspect_safety = false   # (default: true) skip the schema lookup and use
#                               # the built-in fallback map (the bridge also
#                               # falls back automatically if fal's API is down)
#   introspect_retry_seconds = 300.0   # (default) cooldown before retrying a
#                               # failed lookup; until then the fallback map
#                               # applies, so an outage heals without a restart
#
# Per-model escape hatches:
#   disable_safety = false   # (default: true — moderation IS loosened) leave
#                            # the model's own moderation default in place
#   [providers.models.params]  # arbitrary body fields, applied last (override
#   aspect_ratio = "16:9"      # the derived safety setting); pin size/quality,
#   resolution = "2K"          # or set a knob the bridge doesn't recognize
