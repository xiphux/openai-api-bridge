# openai-api-bridge — environment variables
#
# Required: set BRIDGE_API_KEY before starting. Everything else has sensible
# defaults; uncomment and adjust as needed.

# === Required ===

# The bearer token every client must present. The bridge refuses to start if
# this is empty, shorter than 16 characters, or still the placeholder below —
# an empty value would otherwise make `Authorization: Bearer ` a valid
# credential for anyone who can reach the port.
#
#   openssl rand -hex 24
BRIDGE_API_KEY=replace-me-with-a-strong-random-token


# === Provider secrets (referenced from config.toml's *_env fields) ===

# Set the ones matching your [[providers]] blocks' api_token_env fields.
# VENICE_API_TOKEN=
# IMAGEROUTER_API_KEY=
# OPENROUTER_API_KEY=
# FAL_API_KEY=


# === Network ===

# BRIDGE_HOST=0.0.0.0
# BRIDGE_PORT=8080

# Interactive API docs (/docs, /redoc, /openapi.json). FastAPI mounts these
# outside the auth dependency, so they answer without a bearer token — off by
# default; enable only on a trusted network.
# BRIDGE_ENABLE_DOCS=false
# BRIDGE_PUBLIC_BASE_URL=                 # e.g. https://bridge.example.com — leave empty for relative URLs


# Ceiling on an inbound request body. The bridge reads bodies whole on a
# single worker, so one oversized request is felt by every other client.
# 100MB clears a 16-image edit and a large embedding batch; 0 disables it.
# BRIDGE_MAX_REQUEST_MB=100


# === Storage / cache ===

# BRIDGE_CONFIG_PATH=/etc/openai-api-bridge/config.toml
# FILES_DIR=/var/lib/openai-api-bridge/files
# SQLITE_PATH=/var/lib/openai-api-bridge/state.db
# RETENTION_DAYS=30
# MAX_CACHE_GB=50
# EVICTION_INTERVAL_SECONDS=600


# === Concurrency ===

# MAX_CONCURRENT_VIDEO_JOBS=2

# How long GET /v1/models waits on any one provider before leaving it out of
# that listing. The fetch is not cancelled, so the provider's own catalogue
# cache still fills and it reappears on a later request. 0 disables the bound.
# MODELS_TIMEOUT_SECONDS=5


# === Logging ===

# LOG_LEVEL=INFO                          # TRACE/DEBUG/INFO/WARNING/ERROR
