# openai-api-bridge — environment variables
#
# Required: set BRIDGE_API_KEY before starting. Everything else has sensible
# defaults; uncomment and adjust as needed.

# === Required ===

BRIDGE_API_KEY=replace-me-with-a-strong-random-token


# === Provider secrets (referenced from config.toml's *_env fields) ===

# Set the ones matching your [[providers]] blocks' api_token_env fields.
# VENICE_API_TOKEN=
# IMAGEROUTER_API_KEY=
# OPENROUTER_API_KEY=


# === Network ===

# BRIDGE_HOST=0.0.0.0
# BRIDGE_PORT=8080
# BRIDGE_PUBLIC_BASE_URL=                 # e.g. https://bridge.example.com — leave empty for relative URLs


# === Storage / cache ===

# BRIDGE_CONFIG_PATH=/etc/openai-api-bridge/config.toml
# FILES_DIR=/var/lib/openai-api-bridge/files
# SQLITE_PATH=/var/lib/openai-api-bridge/state.db
# RETENTION_DAYS=30
# MAX_CACHE_GB=50
# EVICTION_INTERVAL_SECONDS=600


# === Concurrency ===

# MAX_CONCURRENT_VIDEO_JOBS=2


# === Logging ===

# LOG_LEVEL=INFO                          # TRACE/DEBUG/INFO/WARNING/ERROR
